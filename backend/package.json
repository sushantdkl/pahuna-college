{
  "name": "pahuna-college",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "dev": "npx tsx --watch index.ts",
    "start": "node dist/index.js",
    "build": "tsc",
    "images:audit-placeholders": "tsx scripts/assign-placeholder-images.ts",
    "images:assign-placeholders": "tsx scripts/assign-placeholder-images.ts --assign",
    "images:verify-placeholders": "tsx scripts/assign-placeholder-images.ts --verify",
    "test": "jest --runInBand",
    "test:backend": "jest --runInBand",
    "test:backend:watch": "jest --watch",
    "test:backend:coverage": "jest --coverage --runInBand",
    "email:verify": "tsx scripts/email-verify.ts",
    "email:send-test": "tsx scripts/email-send-test.ts",
    "test:coverage": "jest --coverage --runInBand"
  },
  "keywords": [
    "pahuna",
    "pahuna-college",
    "backend",
    "api",
    "express",
    "mongodb",
    "auth"
  ],
  "author": "",
  "license": "ISC",
  "description": "Backend API for the Pahuna College web project",
  "dependencies": {
    "@types/multer": "^2.1.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.6.3",
    "multer": "^2.1.1",
    "nodemailer": "^9.0.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.9.2",
    "@types/nodemailer": "^8.0.1",
    "@types/supertest": "^6.0.3",
    "jest": "^30.4.2",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  }
}
