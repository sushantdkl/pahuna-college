PORT=4000
MONGODB_URL=mongodb://localhost:27017/pahuna_college
JWT_SECRET=replace-with-a-long-random-secret

# Optional email notifications for Inquiry and Contact Message submissions.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-user@example.com
SMTP_PASS=replace-with-an-app-password
SMTP_FROM=Pahuna Notifications <notifications@example.com>
PAHUNA_NOTIFICATION_EMAIL=hello@example.com

# Password reset email. Keep real values only in local/server .env files.
CLIENT_URL=http://localhost:3000
EMAIL_USER=your-email@example.com
EMAIL_PASS=your-app-password
EMAIL_FROM_NAME=Pahuna
EMAIL_TEST_RECIPIENT=your-test-recipient@example.com
